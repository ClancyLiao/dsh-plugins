{
  "name": "dsh-think-in-chinese",
  "version": "1.0.0",
  "description": "Make the model's thinking/reasoning output always use Simplified Chinese.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6"
  },
  "author": "Clancy",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClancyLiao/dsh-plugins.git"
  },
  "files": [
    "lib",
